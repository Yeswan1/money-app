# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://moneymap:password@localhost:5432/moneymap?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=moneymap-access-secret-change-in-production-minimum-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=moneymap-refresh-secret-change-in-production-minimum-32-characters
JWT_REFRESH_EXPIRATION=7d

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@moneymap.app

# S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=moneymap
S3_REGION=us-east-1


# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=*
